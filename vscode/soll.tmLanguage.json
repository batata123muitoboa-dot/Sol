{
    "scopeName": "source.soll",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.soll",
                    "match": "(#|--).*?$"
                }
            ]
        },

        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.soll",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.soll",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.soll",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.soll",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },

        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.soll",
                    "match": "\\b(funcao|se|senao|enquanto|para|em|de|até|entao|fim|pare|quebrar|retornar)\\b"
                },
                {
                    "name": "storage.modifier.soll",
                    "match": "\\b(set|setl)\\b"
                },
                {
                    "name": "constant.language.soll",
                    "match": "\\b(Verdadeiro|verdadeiro|true|Falso|falso|false)\\b"
                }
            ]
        },

        "functions": {
            "patterns": [
                {
                    "name": "support.function.soll",
                    "match": "\\b(escrever|ler|esperar|limpar|adicionar|atualizar_texto|maiusculo|minusculo|tamanho|aleatorio|item|pegar|janela|texto|caixa_texto|botao)\\b"
                },
                {
                    "name": "entity.name.function.soll",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\()"
                }
            ]
        },

        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.soll",
                    "match": "\\b\\d+(\\.\\d+)?\\b"
                }
            ]
        },

        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.soll",
                    "match": "\\b(diferente|menos\\+|mais\\+|menos|mais|igual|e|ou|nao)\\b"
                }
            ]
        }
    }
}
